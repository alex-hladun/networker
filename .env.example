# Direct URL to your UniFi OS console, without a trailing slash.
UNIFI_URL=https://192.168.1.1

# Create this in UniFi Network > Settings > Control Plane > Integrations.
UNIFI_API_KEY=replace-with-a-read-only-api-key

# Local, read-only UniFi OS service account used for UI-equivalent client telemetry.
UNIFI_USERNAME=network-monitor
UNIFI_PASSWORD=replace-with-a-strong-password

# Classic site slug or site display name. Most single-site consoles use "default".
UNIFI_SITE=default

# Keep true when the console has a trusted certificate. Explicitly set false for
# the self-signed certificate shipped by many local consoles.
UNIFI_VERIFY_TLS=false

POLL_INTERVAL_SECONDS=30
RETENTION_DAYS=30
DATA_DIR=./data

# Use simulated clients and metrics without contacting a console.
UNIFI_FIXTURE_MODE=false
